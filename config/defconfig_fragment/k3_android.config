# K3 Android boot config fragment, applied on top of k3_defconfig
# (selected via uboot.defconfig_fragments in config/boards/spacemit-k3.yaml).
# Modelled on the in-tree configs/am62x_a53_android.config.

# AVB verifies boot + vendor_boot (40M + 32M) in RAM during bootflow; the
# default heap OOMs ("avb_util.c: Failed to allocate memory"), so enlarge it.
CONFIG_SYS_MALLOC_LEN=0x20000000

# K3 DRAM base is 4 GiB, so the Android image's blob load addresses (low, e.g.
# 0x10200000) are unusable. Ignore them and use the bootloader's kernel_addr_r
# / in-place kernel and ramdisk_addr_r instead.
CONFIG_ANDROID_BOOT_IMAGE_IGNORE_BLOB_ADDR=y
